#!/bin/bash
# 把 ISO 里携带的固件镜像写到用户选择的磁盘。
#
# 三条硬约束(都对应踩过的坑):
#   1. 只列"可写的整盘": 只读介质不列出来, 避免把安装介质本身当成目标盘写掉;
#   2. 写入前比较镜像与目标盘容量: 盘不够直接拒绝, 不靠 dd 跑到一半报错;
#   3. dd 的退出码必须检查: 失败绝不能打印 "installed successfully"。
set -u

IMAGE_NAME="custom.img"

show_menu() {
    clear 2>/dev/null || true
    echo "=========================================="
    echo "  ImmortalWrt Installer"
    echo "=========================================="
    echo "1. Install ImmortalWrt"
    echo "0. Quit"
    echo "====================================="
}

size_human() {
    local bytes="${1:-0}"
    if [ "$bytes" -ge 1073741824 ]; then
        awk -v b="$bytes" 'BEGIN { printf "%.2f GB", b / 1073741824 }'
    else
        awk -v b="$bytes" 'BEGIN { printf "%.0f MB", b / 1048576 }'
    fi
}

# 输出候选磁盘列表到 stderr, 把用户选中的盘从 stdout 返回。
# 只接受 lsblk 里 TYPE=disk 且 RO=0 的整盘: 分区、只读介质(安装用的 U 盘/光盘)
# 都不该成为写入目标。
detect_disk() {
    local -a disks=()
    local name ro type dev size model i

    while read -r name ro type; do
        [ "$type" = "disk" ] || continue
        [ "$ro" = "0" ] || continue
        disks+=("/dev/$name")
    done < <(lsblk -d -n -o NAME,RO,TYPE)

    if [ "${#disks[@]}" -eq 0 ]; then
        echo "Error: No writable disk devices detected!" >&2
        exit 1
    fi

    echo "Available disks:" >&2
    for i in "${!disks[@]}"; do
        dev=${disks[$i]}
        size=$(lsblk -bdno SIZE "$dev" 2>/dev/null || echo 0)
        model=$(lsblk -dno MODEL "$dev" 2>/dev/null | sed 's/[[:space:]]*$//')
        printf "%2d. %-14s %10s  %s\n" $((i + 1)) "$dev" "$(size_human "$size")" "${model:-unknown model}" >&2
    done

    local choice=""
    while true; do
        read -r -p "Select target disk number (1-${#disks[@]}): " choice || true
        if [[ "$choice" =~ ^[0-9]+$ ]] && ((choice >= 1 && choice <= ${#disks[@]})); then
            echo "[Security Notice] Selected disk: ${disks[choice-1]}" >&2
            echo "${disks[choice-1]}"
            return 0
        fi
        echo "Invalid input. Please enter a valid number between 1-${#disks[@]}" >&2
    done
}

confirm_danger() {
    local target_disk=$1
    local image_file=$2
    local target_size=$3

    echo "!! DANGEROUS OPERATION CONFIRMATION !!"
    echo "──────────────────────────────────────"
    echo "Target device: $target_disk ($(size_human "$target_size"))"
    echo "Image file:    $image_file"
    echo "──────────────────────────────────────"
    echo "This will ERASE ALL DATA on $target_disk!"
    read -r -p "Confirm write operation? (Type uppercase YES to proceed): " confirm || true
    if [ "${confirm:-}" != "YES" ]; then
        echo "Operation cancelled"
        exit 0
    fi
}

install_system() {
    local image_file="/mnt/$IMAGE_NAME"
    local target_disk image_size disk_size

    # 镜像是否存在, 先查清楚再让用户选盘
    if [ ! -f "$image_file" ]; then
        echo "Error: Image file $image_file not found!" >&2
        echo "The installer ISO is incomplete; please download it again." >&2
        exit 1
    fi
    image_size=$(stat -c%s "$image_file")

    target_disk=$(detect_disk)
    disk_size=$(lsblk -bdno SIZE "$target_disk" 2>/dev/null || echo 0)

    echo -e "\nDisk information:"
    lsblk -dno NAME,SIZE,MODEL "$target_disk" 2>/dev/null || true
    echo "Image size: $(size_human "$image_size")"

    # 容量不足时直接拒绝: 让 dd 写一半才失败, 用户看到的是"安装成功"之外的
    # 一堆 IO 报错, 目标盘还处于半写入状态。
    if [ "${disk_size:-0}" -lt "$image_size" ]; then
        echo "Error: target disk $(size_human "$disk_size") is smaller than the image $(size_human "$image_size")" >&2
        echo "Please choose a larger disk." >&2
        exit 1
    fi

    confirm_danger "$target_disk" "$image_file" "$disk_size"

    echo -e "\nStarting system write... (Press Ctrl+C to cancel)"
    sleep 2

    if ! dd if="$image_file" of="$target_disk" bs=4M conv=fsync status=progress; then
        echo "──────────────────────────────────────" >&2
        echo "Error: writing to $target_disk failed (disk full / IO error / device busy)." >&2
        echo "The target disk is now in a partial state; please retry." >&2
        exit 1
    fi
    sync

    echo "──────────────────────────────────────"
    echo "ImmortalWrt installed successfully on $target_disk"
    echo "You can power off, remove the install media, and boot from the disk."
}

while true; do
    show_menu
    read -r -p "Enter your choice [0-1]: " choice || true

    case "${choice:-}" in
        1)
            install_system
            break
            ;;
        0)
            echo "Exiting installer"
            exit 0
            ;;
        *)
            echo "Invalid option, please try again"
            sleep 2
            ;;
    esac
done
